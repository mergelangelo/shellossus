# Copy values into the USER config via shellossus -Setup, not into this repository.
SHELLOSSUS_BASE_URL="https://YOUR-SERVER/v1"
SHELLOSSUS_MODEL="YOUR-MODEL-ID"
SHELLOSSUS_API_KEY="YOUR-KEY"
# Empty = the folder where you run shellossus.
SHELLOSSUS_WORKSPACE=""

# Optional runtime, gateway, search, and UI settings (uncomment as needed):
# SHELLOSSUS_STREAM="true"
# SHELLOSSUS_REQUEST_TIMEOUT_SEC="180"
# SHELLOSSUS_AUTH_HEADER="api-key"
# SHELLOSSUS_EXTRA_HEADERS='{"X-Title":"shellossus","HTTP-Referer":"https://example.com"}'
# SHELLOSSUS_MAX_TOKENS="4096"
# SHELLOSSUS_TEMPERATURE="0.2"
# SHELLOSSUS_SEARCH_URL="https://searx.example.com/search?q={query}&format=json"
# SHELLOSSUS_THEME="gruvbox-material"
